# ============================================================
# Backend — Variáveis de Ambiente (copie para .env e preencha)
# ============================================================

# --- Banco de dados (obrigatório) ---
DATABASE_URL=postgres://usuario:senha@localhost:5432/nome_banco
# Força conexão SSL (útil no Render, Heroku, etc.)
DATABASE_SSL=false

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Autenticação (obrigatório) ---
JWT_SECRET=cole_um_segredo_forte_aqui

# --- CORS ---
# Origens permitidas separadas por vírgula (padrão: localhost:3001)
FRONTEND_URL=http://localhost:3001

# --- E-mail (opcional) ---
# Prioridade: RESEND_API_KEY > SMTP_URL / SMTP_HOST > log no console.
# Se nenhum estiver configurado, os e-mails são impressos no log (mock).
#
# Resend (preferido):
RESEND_API_KEY=
RESEND_FROM=UERN Inova <seu-email@dominio.com>
#
# SMTP (alternativa):
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@uern-inova.local

# --- Scripts auxiliares (opcional) ---
# Usados por: node scripts/seed-admin.js
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@uern.br
ADMIN_SENHA=Troque@123
ADMIN_USERNAME=admin

# Usado por: node scripts/importar-planilha.js
# PLANILHA_PATH=./caminho/para/planilha.csv
